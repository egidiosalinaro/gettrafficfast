# This deployment (lib/site.ts). Every value has a default, so the hosted
# product needs none of them; a self-hosted deployment sets its own.
# Public origin, used for canonical URLs, OAuth metadata, the sitemap,
# webhook URLs and the user agent of outgoing requests. Default: https://gettrafficfa.st
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
# The public support inbox shown on every page. Default: support@example.com
# NEXT_PUBLIC_CONTACT_EMAIL=support@your-domain.example
# First name of the person who answers that inbox, shown in the FAQ and /docs.
# Unset: the pages say "the maintainer".
# NEXT_PUBLIC_OPERATOR_NAME=
# DataFast visitor analytics for this site (docs/DATAFAST.md), loaded only
# after the visitor accepts the cookie banner. Unset: no script, no banner.
# NEXT_PUBLIC_DATAFAST_WEBSITE_ID=

# Platform owner (lib/owner.ts). Comma-separated Supabase user ids that see
# the costs page and the owner tools and set accounts' AI spend ceilings.
# Fail closed: empty means nobody.
PLATFORM_OWNER_USER_IDS=
# Optional: the platform's own sites (comma-separated site ids). When set, the
# owner-only screens and tools apply only while one of these sites is selected
# (or is the site an API key / MCP call resolves to); on any other site the
# owner sees exactly what a customer sees. Empty: the owner sees them on every
# site.
PLATFORM_OWNER_BUSINESS_IDS=
# Daily AI spend ceiling (USD) of every account without its own ceiling
# (lib/limits/spend.ts). Default 5.
# ACCOUNT_DAILY_SPEND_USD=5
# Addresses (comma-separated, case-insensitive) that sign in with a password
# instead of a magic link: a directory reviewer's account (lib/password-login.ts,
# docs/API.md). Empty: nobody.
PASSWORD_LOGIN_EMAILS=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Used only by /api/stripe-webhook and /api/cron/* (server, never exposed to client)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Self-hosting without billing (docs/SELF_HOSTING.md): exactly 1 gives every
# signed-in account access and hides the billing screens; the Stripe values
# above can then stay empty. Unset (the hosted service) keeps the paywall.
# BILLING_DISABLED=1

# LLM provider. The API key is vendor-specific; everything else is a tier.
GEMINI_API_KEY=
# LLM_PROVIDER=gemini
# LLM_MODEL_FAST=gemini-2.5-flash
# LLM_MODEL_QUALITY=gemini-2.5-pro
#
# Fallback (optional): any request the primary fails, for any reason, goes
# once to Claude (see docs/AGENT_RUNTIME.md). Off unless LLM_FALLBACK is set:
# the key alone spends nothing.
# LLM_FALLBACK=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# ANTHROPIC_MODEL_QUALITY=claude-sonnet-5-5
#
# The article writer's own provider (optional): the writer and its revision
# ask this provider first, every other agent stays on LLM_PROVIDER, which then
# stands behind the writer as its fallback. Naming it here is the consent to
# spend on it; its key must be set.
# LLM_WRITER_PROVIDER=anthropic
#
# The article rotation (optional): a comma list of providers. Every model
# call of article production asks the provider of the UTC day first (day
# number mod list length) and the next one in the list stands behind it; a
# job keeps the arm it started with. While set it takes precedence over
# LLM_WRITER_PROVIDER for the article agents; everything else is untouched.
# Naming a provider here is the consent to spend on it; each key must be set.
# See docs/AGENT_RUNTIME.md, "The article rotation".
# LLM_ARTICLE_ROTATION=gemini,anthropic
# Ceiling per article, across every agent and every retry of its job.
# AGENT_BUDGET_USD=0.50
# Set to 1 to keep verbose content tracing in production (see docs/AGENT_RUNTIME.md).
# CONTENT_TRACE=

# Media enrichment (optional; on for every site by default, each site can turn it off in
# Settings -> Generation; see docs/MEDIA.md).
# Image provider default: imagen (uses GEMINI_API_KEY; requires a billed key).
# Article images are generated only when the deployment opts in: images are
# on for every site by default, and the default provider uses the same key as
# the text models, so the key alone must not start spending.
# IMAGES_ENABLED=1
# IMAGE_PROVIDER=imagen
# OPENAI_API_KEY=            # enables the 'openai' image provider
# IMAGE_MODEL_IMAGEN=imagen-3.0-generate-002
# Gemini image models for the standard and high quality tiers
# (lib/providers/images/google.ts).
# IMAGE_MODEL_GEMINI=gemini-3.1-flash-image
# IMAGE_MODEL_GEMINI_HIGH=gemini-3-pro-image
# IMAGE_MODEL_OPENAI=gpt-image-1
# YOUTUBE_API_KEY=           # enables YouTube video enrichment

# Shared secret for THIS site's own blog, which receives its articles through
# the ordinary Webhooks integration like any customer (see docs/BLOG.md). Must
# match the secret entered in Settings -> Integrations -> Webhooks. Without it
# the receiver refuses every delivery.
BLOG_WEBHOOK_SECRET=
# Comma-separated user ids allowed to publish into this site's own blog; empty means nobody.
OWN_BLOG_OWNER_USER_IDS=

# Cron auth: the Bearer token every /api/cron/* route and /api/jobs/tick
# expects. The schedules live in vercel.json (Vercel Cron; the 5-minute job
# tick needs a plan that allows it). Elsewhere, call the same routes from any
# scheduler with `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
# Self-hosting only (lib/client-ip.ts). Leave unset on Vercel, whose own headers
# carry the caller's address. Behind your own proxies, set it to how many sit in
# front of the app (load balancer + reverse proxy = 2): the address is then read
# from that position in x-forwarded-for, from the right, and nothing else the
# client sends is believed. Unset off Vercel, a caller can pick its own address
# and step around the per-address limits.
# TRUSTED_PROXY_HOPS=

# Encryption key for third-party credentials stored in `integrations.config`.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATIONS_ENCRYPTION_KEY=

# Notification emails (article generation failed, integration broken).
# Sent via Resend; without RESEND_API_KEY the cron just skips notifications.
# The From address must be on a domain verified in the Resend account.
RESEND_API_KEY=
# Default: "GetTrafficFast <notifications@<host of NEXT_PUBLIC_SITE_URL>>".
NOTIFICATIONS_FROM_EMAIL="GetTrafficFast <notifications@your-domain.example>"
# Where operator alerts go (LLM billing refusals); defaults to the contact inbox when empty.
OPERATOR_EMAIL=

# Sentry (error monitoring, optional; docs/SENTRY.md). Unset DSN: Sentry is off.
# The DSN is public by design (it ships to the browser).
NEXT_PUBLIC_SENTRY_DSN=
# Build time only, to upload readable source maps: the organization and
# project slugs, and an auth token created in your Sentry organization's settings.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Citation probing (optional — see docs/CITATIONS.md). With no engine enabled
# the weekly sweep reports itself disabled and records nothing. Every probe is
# a paid call, multiplied by the number of engines configured.
#
# Gemini with Google Search grounding needs no new vendor: it reuses
# GEMINI_API_KEY. Opt-in on purpose, because grounded queries are billed and a
# cost must not switch itself on because an unrelated key exists.
# CITATIONS_GEMINI=true
# CITATIONS_GEMINI_MODEL=gemini-2.5-flash
#
# Perplexity is the second engine. Optional: engine rates are compared, never
# averaged, so one engine is a valid configuration.
PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar

# Google Search Console (optional — see docs/ANALYTICS.md). Per-user OAuth: the
# customer grants read-only access to their own property, so these are the
# platform's app credentials, not anyone's data. Create them in Google Cloud
# with the redirect URI <your-origin>/api/integrations/search-console/callback.
# Without them the connect flow is unavailable and the daily sweep reports
# itself disabled; nothing else degrades.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# SERP data (optional — see docs/INTELLIGENCE.md). Serper.dev, paid per query.
# Without it the research step is skipped and web-search discovery is off.
SERPER_API_KEY=

# Off-site discovery (optional — see docs/PLACEMENTS.md). Three providers,
# each degrading on its own; the product only ever finds and writes, a person
# publishes.
#
# Web search: rides on SERPER_API_KEY above, scoped to reddit.com, github.com,
# linkedin.com, x.com and a set of communities. This is how Reddit threads are
# found when Reddit's own API below is not connected.
#
# GitHub: free public search API, opt-in like every other surface because what
# it finds is then judged by a paid model call. PLACEMENTS_GITHUB=true enables
# it without a key; GITHUB_TOKEN enables it too and raises the rate limit
# (8 → 28 searches a minute).
# PLACEMENTS_GITHUB=true
# GITHUB_TOKEN=
#
# Reddit's official app-only OAuth, read-only: the sweep finds public threads
# worth answering and never posts anything. Without credentials Reddit is left
# to the web search (SERPER_API_KEY), which is the path that works today.
#
# Do not try reddit.com/prefs/apps for a new app. Since November 2025 that
# page redirects to the Responsible Builder Policy and does not create
# credentials. New client id/secret need Reddit's written approval (commercial
# form: support.reddithelp.com, ticket_form_id=14868593862164, enterprise).
# Existing pre-policy apps still work if you already have them.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
#
# X's official API, pay-per-use, read-only (see docs/PLACEMENTS.md, "Fresh
# posts and reply numbers from the X API"): a daily search for fresh posts
# on every site's topics, and the daily numbers of the replies posted
# there. Off unless X_API_ENABLED=1: the token alone spends nothing. Every
# call is checked first against a hard monthly cap (UTC calendar month),
# estimated from X's per-post prices. Nothing is ever posted on X.
# X_API_ENABLED=1
# X_API_BEARER_TOKEN=
# X_API_MONTHLY_CAP_USD=20
#
# The daily run also searches the accounts each site replies to most
# (docs/PLACEMENTS.md, "Close accounts"), every site, under the same switch
# and cap: nothing else to set.
# REDDIT_USER_AGENT="web:gettrafficfast:v1.0 (by /u/yourusername)"
#
# MCP Registry domain proof (docs/API.md, "Distribution"): the PUBLIC key
# line served at /.well-known/mcp-registry-auth, so the owner can publish
# under st.gettrafficfa/…. Unset: that path is 404. Never the private key.
# MCP_REGISTRY_AUTH="v=MCPv1; k=ed25519; p=<base64 public key>"
